{
  "version": 2,
  "builds": [
    {
      "src": "core/api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "main/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/core/api/$1.js"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json))",
      "dest": "/main/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/main/index.html"
    }
  ]
}
