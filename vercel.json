{
  "version": 2,
  "builds": [
    {
      "src": "core/api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "main/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/core/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/main/$1"
    }
  ]
}
